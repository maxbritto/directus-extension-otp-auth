{
  "name": "directus-extension-otp-auth",
  "version": "1.0.0",
  "description": "Directus extension for passwordless email OTP authentication",
  "author": "Maxime Britto",
  "license": "MIT",
  "keywords": [
    "directus",
    "directus-extension",
    "otp",
    "authentication",
    "passwordless",
    "email"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "host": "11.9.0",
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "otp-auth",
        "source": "src/otp-endpoint/index.ts"
      },
      {
        "type": "hook",
        "name": "otp-hook",
        "source": "src/otp-hook/index.ts"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "test": "jest"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "14.0.0",
    "@jest/globals": "^30.1.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.0.3",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3"
  }
}
